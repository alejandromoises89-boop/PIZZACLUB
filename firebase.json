{
  "firestore": [
    {
      "database": "ai-studio-android-pizzaclu-26d3b8a1-697e-40e6-a619-f86f22ddfb34",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "public": "web-pwa",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "ui": {
      "enabled": false
    }
  }
}
