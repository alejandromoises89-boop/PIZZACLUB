{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Single-size artisan pizza flavor in the Pizza Club catalog.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Display name of the pizza flavor." },
        "description": { "type": "string", "description": "Appetizing description of ingredients." },
        "pricePyg": { "type": "integer", "description": "Price in Paraguayan Guaranies (PYG)." },
        "active": { "type": "boolean", "description": "Whether the product is currently visible for ordering." },
        "imageKey": { "type": "string", "description": "Local drawable key or asset identifier." },
        "sortOrder": { "type": "integer", "description": "Catalog display sort order." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update." }
      },
      "required": ["name", "description", "pricePyg", "active", "imageKey", "sortOrder", "createdAt", "updatedAt"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Real-time stock tracking per pizza flavor.",
      "type": "object",
      "properties": {
        "productName": { "type": "string", "description": "Flavor name for quick admin reference." },
        "stock": { "type": "integer", "description": "Available units (>= 0)." },
        "lowStockThreshold": { "type": "integer", "description": "Threshold that triggers low stock alerts." },
        "updatedBy": { "type": "string", "description": "Admin UID or system identifier." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last stock update." }
      },
      "required": ["productName", "stock", "lowStockThreshold", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer pre-order with PII, delivery/pickup details, and manual bank transfer verification state.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "description": "Human-readable unique order number." },
        "customerName": { "type": "string", "description": "Customer full name." },
        "customerPhone": { "type": "string", "description": "Customer contact phone." },
        "desiredDate": { "type": "string", "description": "Desired delivery or pickup date." },
        "additionalInstructions": { "type": "string", "description": "Optional order instructions." },
        "preparationMode": {
          "type": "string",
          "enum": ["Lista para comer", "Lista para hornear en casa"],
          "description": "Preparation mode selected by the customer."
        },
        "fulfillmentType": {
          "type": "string",
          "enum": ["DELIVERY", "PICKUP"],
          "description": "Delivery or pickup option."
        },
        "neighborhood": { "type": "string", "description": "Delivery neighborhood in Ciudad del Este." },
        "streetAndNumber": { "type": "string", "description": "Street and house number for delivery." },
        "deliveryReference": { "type": "string", "description": "Landmarks or delivery reference." },
        "googleMapsLink": { "type": "string", "description": "Optional Google Maps URL." },
        "pickupDate": { "type": "string", "description": "Preferred pickup date." },
        "pickupTime": { "type": "string", "description": "Preferred pickup time." },
        "items": { "type": "array", "description": "Ordered pizza line items." },
        "subtotalPyg": { "type": "integer", "description": "Order subtotal in PYG." },
        "totalAmountPyg": { "type": "integer", "description": "Order total in PYG." },
        "status": {
          "type": "string",
          "enum": ["PENDING_PAYMENT", "PAYMENT_CONFIRMED", "PREPARING", "READY_FOR_PICKUP", "OUT_FOR_DELIVERY", "COMPLETED", "CANCELLED"],
          "description": "Order lifecycle status."
        },
        "whatsappUnlocked": { "type": "boolean", "description": "True only after admin verifies bank deposit." },
        "paymentMethod": { "type": "string", "description": "BANK_TRANSFER." },
        "paymentBank": { "type": "string", "description": "Itaú Paraguay." },
        "paymentAlias": { "type": "string", "description": "Payment alias displayed at checkout." },
        "paymentConfirmedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of admin payment confirmation." },
        "confirmedByAdminId": { "type": "string", "description": "UID of admin who confirmed payment." },
        "confirmedByAdminEmail": { "type": "string", "description": "Email of admin who confirmed payment." },
        "cancellationReason": { "type": "string", "description": "Optional cancellation reason." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update." }
      },
      "required": [
        "orderNumber", "customerName", "customerPhone", "desiredDate",
        "preparationMode", "fulfillmentType", "items", "subtotalPyg",
        "totalAmountPyg", "status", "whatsappUnlocked", "paymentMethod",
        "paymentBank", "paymentAlias", "createdAt", "updatedAt"
      ]
    },
    "OrderStatusTracker": {
      "title": "OrderStatusTracker",
      "description": "Non-PII live status projection allowing unregistered customers to poll/listen to payment confirmation.",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "description": "Human-readable unique order number." },
        "status": {
          "type": "string",
          "enum": ["PENDING_PAYMENT", "PAYMENT_CONFIRMED", "PREPARING", "READY_FOR_PICKUP", "OUT_FOR_DELIVERY", "COMPLETED", "CANCELLED"]
        },
        "whatsappUnlocked": { "type": "boolean", "description": "Unlocked after admin confirms payment." },
        "totalAmountPyg": { "type": "integer", "description": "Order total in PYG." },
        "fulfillmentType": { "type": "string", "enum": ["DELIVERY", "PICKUP"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "status", "whatsappUnlocked", "totalAmountPyg", "fulfillmentType", "createdAt", "updatedAt"]
    },
    "Administrator": {
      "title": "Administrator",
      "description": "Authenticated Pizza Club administrator profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "SUPER_ADMIN"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "active", "createdAt"]
    },
    "PaymentAuditLog": {
      "title": "PaymentAuditLog",
      "description": "Immutable audit record for payment approvals, cancellations, and inventory adjustments.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "adminId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string", "enum": ["CONFIRM_PAYMENT", "CANCEL_ORDER", "STATUS_CHANGE", "STOCK_ADJUSTMENT"] },
        "previousStatus": { "type": "string" },
        "newStatus": { "type": "string" },
        "amountPyg": { "type": "integer" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "orderNumber", "adminId", "adminEmail", "action", "previousStatus", "newStatus", "amountPyg", "createdAt"]
    },
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Editable business configuration for Pizza Club.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string" },
        "instagramHandle": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "bankName": { "type": "string" },
        "paymentAlias": { "type": "string" },
        "deliveryCity": { "type": "string" },
        "currency": { "type": "string" },
        "acceptingOrders": { "type": "boolean" },
        "treasureCode": { "type": "string" },
        "treasureReward": { "type": "string" },
        "googleReviewUrl": { "type": "string" },
        "pwaInstallUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["brandName", "instagramHandle", "whatsappNumber", "bankName", "paymentAlias", "deliveryCity", "currency", "acceptingOrders", "updatedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Active and archived pizza flavors."
    },
    "/inventory/{productId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Available pizza stock per flavor."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer pre-orders (PII isolated to administrators)."
    },
    "/order_status/{orderId}": {
      "schema": { "$ref": "#/entities/OrderStatusTracker" },
      "description": "Non-PII order status tracker for unregistered customer checkout."
    },
    "/administrators/{adminUid}": {
      "schema": { "$ref": "#/entities/Administrator" },
      "description": "Authorized admin accounts."
    },
    "/payment_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/PaymentAuditLog" },
      "description": "Immutable payment and status audit trail."
    },
    "/business_settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Editable storefront and bank transfer settings."
    }
  }
}
